<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon, carried over unchanged from the Expo build so the app
     looks like an update and not like a different app: a burning fuse, amber
     behind the spark and dead ahead of it.

     The background is the flat colour the Expo manifest used (`adaptiveIcon
     .backgroundColor`), not an image — the foreground already carries the whole
     mark inside the 72dp safe zone.

     `monochrome` is what Android 13+ themed icons tint; without it the launcher
     falls back to shrinking the full icon into a grey blob. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
