# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Every build-time credential, in one file: the TikTok access token plus the
# AdMob ids. Read by --dart-define-from-file and, for ADMOB_APP_ID, by gradle.
# See exitplan.env.example for the shape, and lib/core/tiktok_config.dart for
# why the token in particular must never be committed.
/exitplan.env

# Firebase project config for Analytics/Remote Config. Same discipline as
# exitplan.env above: a checkout without it still builds (see the file-exists
# guard around the google-services Gradle plugin in android/app/build.gradle.kts)
# — it just runs with Firebase silently disabled instead of failing.
/android/app/google-services.json
