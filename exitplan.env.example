# Every build-time credential this app has, in one file. Copy and fill in:
#
#   cp exitplan.env.example exitplan.env
#
# `exitplan.env` is git-ignored. Build with it:
#
#   flutter build appbundle --release --dart-define-from-file=exitplan.env
#
# One file and one flag, deliberately. These used to be two files plus a
# separate -P gradle flag, which meant three things that could each be forgotten
# independently — and each one fails silently and differently: no attribution,
# live builds serving test ads, or a manifest carrying Google's test app id.
#
# Omitting the flag entirely is still safe. TikTok stays inert and AdMob falls
# back to Google's official TEST units, which say TEST AD across the banner —
# obviously wrong rather than quietly wrong. That default is on purpose: serving
# live ads from a debug session is a known route to an AdMob suspension.
#
# Gradle reads ADMOB_APP_ID straight out of this same file (see
# android/app/build.gradle.kts), because the ad SDK needs it in the manifest
# before any Dart runs and so it cannot travel by --dart-define.

# --- TikTok Events SDK ------------------------------------------------------
# From TikTok Events Manager -> the app -> Setup / Credentials.
# Used only to attribute installs to the campaign that paid for them; see
# lib/services/tiktok_analytics.dart for exactly what is and is not sent.

# The numeric TikTok App ID.
TIKTOK_APP_ID=7669865454432813063

# The `TTK…` access token. The one genuine secret in this file — it grants write
# access to the app's event stream, and a value committed once can never be
# un-committed. Optional on Android (installs are attributed from the App ID
# alone) but required once iOS ships.
TIKTOK_ACCESS_TOKEN=

# --- AdMob ------------------------------------------------------------------
# Publisher account: pub-4512388051733069
# From AdMob -> Apps -> ExitPlan.
#
# Neither of these is secret in the cryptographic sense: both are visible in any
# APK and in any ad request. They live here so that nobody building from a copy
# of this repo can accidentally serve ads against your account — invalid traffic
# is what gets AdMob accounts suspended.

# The app id, with a ~ in it. Read by gradle, not by Dart.
ADMOB_APP_ID=

# The anchored banner unit, with a / in it. Shown on home, settings, browse,
# category detail and fake calls — never on a screen that can fire a sound.
ADMOB_BANNER_UNIT=
